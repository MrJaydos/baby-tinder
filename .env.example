# Copy this file to .env and fill in your values
SECRET_KEY=change-this-to-a-long-random-string

# App database (stores users, swipes, matches) — SQLite via Docker volume by default
DATABASE_URL=sqlite:////data/database.db

# PostgreSQL (optional, use this if Coolify provides a Postgres service)
# DATABASE_URL=postgresql://user:password@db:5432/babytinder

# names.db (the baby names source) is bundled in the Docker image automatically.
# On first startup the app imports names from names.db into the app database.

# ── AI portrait images ────────────────────────────────────────────────────────
# Where to cache generated images (persisted via the /data Docker volume).
IMAGE_DIR=/data/images

# Default: Pollinations.ai (free, no key needed — images generated via their
# servers and cached locally on first view).

# For fully local / offline generation, point at a running AUTOMATIC1111 instance:
# IMAGE_API_URL=http://your-automatic1111-host:7860
# Add it to docker-compose as a separate service (needs a GPU for reasonable speed).
